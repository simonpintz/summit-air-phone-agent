# --- Vapi ---
# API key from https://dashboard.vapi.ai/ -> Settings -> API Keys (use the Private key)
VAPI_API_KEY=

# Shared secret used to sign/verify tool webhook requests (Vapi sends this as the
# x-vapi-signature header, HMAC-SHA256 of the raw body). Generate any random string,
# e.g. `openssl rand -hex 32`, and put the SAME value in the Vapi tool config.
VAPI_TOOL_SECRET=

# --- Backend ---
# Public base URL of the deployed backend (e.g. https://summit-air-backend.onrender.com).
# Used by vapi/deploy.py to point tool webhooks at the right place.
BACKEND_BASE_URL=http://localhost:8000

# Path to the SQLite database file used by the backend.
DATABASE_PATH=./bookings.db

# --- Slack ---
# Incoming webhook URL from https://api.slack.com/apps -> your app -> Incoming Webhooks
SLACK_WEBHOOK_URL=

# --- Optional ---
# Simple bearer token to protect the /bookings admin view. Leave blank to disable auth
# (fine for a short-lived demo, not recommended long-term).
ADMIN_TOKEN=
